# Environment (development | production | test)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Config
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerradar_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerradar_test_db

# Background Task Queue (Redis + Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security & JWT
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SerpApi Integration (Google Jobs)
SERPAPI_API_KEY=
SERPAPI_MOCK_MODE=true

# AI / LLM Integration
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Next.js Frontend Public Config
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
